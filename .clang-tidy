# Start from no checks, then explicitly enable useful groups.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  readability-misleading-indentation,
  misc-definitions-in-headers,
  misc-header-include-cycle,
  misc-const-correctness,
  cppcoreguidelines-pro-type-reinterpret-cast,
  readability-duplicate-include

# Allow _code as it is the struct tag used by glibcs syslog CODE definition.
CheckOptions:
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_code'

# Make enabled-check warnings fail CI.
WarningsAsErrors: '*'

# Analyze project headers, but not system headers.
HeaderFilterRegex: '.*'
SystemHeaders: false

# Do not apply formatting changes automatically.
FormatStyle: none
