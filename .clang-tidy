# Start from no checks, then explicitly enable useful groups.
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,

  # Avoid noisy or primarily stylistic findings.
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters

# Make enabled-check warnings fail CI.
WarningsAsErrors: '*'

# Analyze project headers, but not system headers.
HeaderFilterRegex: '.*'
SystemHeaders: false

# Do not apply formatting changes automatically.
FormatStyle: none

# Don't analyze generated or vendored source files.
ExcludeHeaderFilterRegex: '(^|/)(build|generated|third_party|vendor)/'
